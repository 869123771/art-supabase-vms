{
  "name": "@art-supabase/vms-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Art Supabase Pro 的 VMS 车辆管理业务模块",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit --pretty false && vite build",
    "preview": "vite preview",
    "boundary:audit": "tsx scripts/audit-module-boundary.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "check": "pnpm boundary:audit && pnpm typecheck && pnpm test:unit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "art-supabase-pro": "https://codeload.github.com/869123771/art-supabase-pro/tar.gz/7f3259e88386576ab9718c5bb527ded9cd66fc75",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.2",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.38",
    "sass": "^1.101.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vue-tsc": "~3.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wangyanghub/art-supabase-vms.git"
  },
  "license": "ISC"
}
